:80 {
    root * /var/www/frontend

    # Route public APIs to backend (BaaS and Auth for Dashboard)
    handle /api/v1/baas/* {
        reverse_proxy auth-service:8000
    }
    handle /api/v1/auth/* {
        reverse_proxy auth-service:8000
    }

    # Explicitly block platform internal APIs and anything else under /api/v1
    handle /api/v1/platform/* {
        respond "Forbidden" 403
    }
    handle /api/v1/* {
        respond "Forbidden" 403
    }

    # Serve static React frontend and fallback to index.html for SPA routing
    handle {
        try_files {path} /index.html
        file_server
    }
}